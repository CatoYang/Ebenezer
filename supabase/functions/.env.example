# Copy to supabase/functions/.env for local development. Never commit the real file.
# Use the DEV bot's token here; production values are set with `supabase secrets set`.
BOT_TOKEN=
# Any long random string, e.g. `openssl rand -hex 32`
WEBHOOK_SECRET=
SCHEDULER_SECRET=
# Public Mini App address (GitHub Pages). Optional until the app is published.
MINIAPP_URL=
# Optional: Telegram user ID of the maintainer, who gets a warning when the database passes 80% of its quota.
ALERT_TELEGRAM_USER_ID=
# The plan's database size quota in MB (Free 500, Pro 8000). Defaults to 500.
DB_QUOTA_MB=
